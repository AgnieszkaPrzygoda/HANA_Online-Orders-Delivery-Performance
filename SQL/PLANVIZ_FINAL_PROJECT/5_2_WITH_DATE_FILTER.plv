<?Version 38?>
<Plan ID="ID_2139748_3637FD460DBED54BAD5B3B49067FF2F6_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT
    "ORDER_DATE",
    SUM("ORDER_VALUE") AS "TOTAL_ORDER_VALUE"
FROM "CAC_R_DELIVERY_PERFORMANCE"
WHERE "ORDER_DATE" >= DATE'2026-10-01'
  AND "ORDER_DATE" < DATE'2026-11-01'
GROUP BY "ORDER_DATE"
ORDER BY "ORDER_DATE"]]></SQL>
