<?Version 38?>
<Plan ID="ID_2139748_9917874B83544447942585AE2232236C_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT
    D.CALENDAR_DATE AS ORDER_DATE,
    C.CARRIER_NAME,
    SUM(O.AMOUNT) AS TOTAL_ORDER_VALUE
FROM "FACT_ORDERS" O
LEFT JOIN "DIM_DATE" D
    ON O.DATE_ID = D.DATE_ID
LEFT JOIN "DIM_CARRIER" C
    ON O.CARRIER_ID = C.CARRIER_ID
WHERE D.CALENDAR_DATE >= '2026-10-01'
  AND D.CALENDAR_DATE < '2026-11-01'
GROUP BY
    D.CALENDAR_DATE,
    C.CARRIER_NAME
ORDER BY
    D.CALENDAR_DATE,
    C.CARRIER_NAME]]></SQL>
<SystemVersion><![CDATA[{"Version":"4.00.000.00.1791475825","CompileType":"rel","USER_NAME":"Capturing USER_NAME is disabled","SCHEMA_NAME":"APRZYGODA_HANA_FINAL_PROJECT_HDI_DB_1"}]]></SystemVersion>
