<?Version 38?>
<Plan ID="ID_2139748_9D289A04C71A7549B6F088AF12B3DC54_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT
    "ORDER_DATE",
    "CARRIER_NAME",
    SUM("ORDER_VALUE") AS "TOTAL_ORDER_VALUE"
FROM "CAC_R_DELIVERY_PERFORMANCE"
WHERE "ORDER_DATE" >= '2026-10-01'
  AND "ORDER_DATE" < '2026-11-01'
GROUP BY
    "ORDER_DATE",
    "CARRIER_NAME"
ORDER BY
    "ORDER_DATE",
    "CARRIER_NAME"]]></SQL>
