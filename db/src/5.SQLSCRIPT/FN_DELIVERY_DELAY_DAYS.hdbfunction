FUNCTION "FN_DELIVERY_DELAY_DAYS"(
    IN IN_EXPECTED_DATE DATE,
    IN IN_ACTUAL_DATE DATE
)
RETURNS DELAY_DAYS INTEGER
LANGUAGE SQLSCRIPT
AS
BEGIN

    IF :IN_EXPECTED_DATE IS NULL
       OR :IN_ACTUAL_DATE IS NULL THEN
        DELAY_DAYS = NULL;

    ELSEIF :IN_ACTUAL_DATE > :IN_EXPECTED_DATE THEN
        DELAY_DAYS = DAYS_BETWEEN(
            :IN_EXPECTED_DATE,
            :IN_ACTUAL_DATE
        );

    ELSE
        DELAY_DAYS = 0;
    END IF;

END;