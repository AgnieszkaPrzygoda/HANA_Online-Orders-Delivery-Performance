  <calculationView xsi:type="Calculation:JoinView" id="Join_FACT_DIM_1" cardinality="CN_1" joinType="leftOuter" multiJoinNode="Join_FACT_DIM" multiJoinCentralTable="ORDERS" multiJoinOrder="Outside In">
