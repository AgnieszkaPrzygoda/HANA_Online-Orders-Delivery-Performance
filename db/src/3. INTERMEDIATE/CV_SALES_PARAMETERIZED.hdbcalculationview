      <viewAttribute hidden="true" id="JOIN$PRODUCT_ID$PRODUCT_ID"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="ORDERS">
      <mapping xsi:type="Calculation:AttributeMapping" target="AMOUNT" source="AMOUNT"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="DATE_ID" source="DATE_ID"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$PRODUCT_ID$PRODUCT_ID" source="PRODUCT_ID"/>
    </input>
    <input node="PRODUCTS">
      <mapping xsi:type="Calculation:AttributeMapping" target="CATEGORY" source="CATEGORY"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$PRODUCT_ID$PRODUCT_ID" source="PRODUCT_ID"/>
    </input>
    <joinAttribute name="JOIN$PRODUCT_ID$PRODUCT_ID"/>
  </calculationView>
  <calculationView xsi:type="Calculation:JoinView" id="Join_FACT_DIM_2" cardinality="CN_1" joinType="leftOuter" multiJoinNode="Join_FACT_DIM" multiJoinCentralTable="ORDERS" multiJoinOrder="Outside In">
    <viewAttributes>
      <viewAttribute id="AMOUNT" aggregationType="sum"/>
      <viewAttribute id="CALENDAR_DATE"/>
      <viewAttribute id="CATEGORY"/>
      <viewAttribute hidden="true" id="JOIN$DATE_ID$DATE_ID"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="Join_FACT_DIM_1">
      <mapping xsi:type="Calculation:AttributeMapping" target="AMOUNT" source="AMOUNT"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="CATEGORY" source="CATEGORY"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$DATE_ID$DATE_ID" source="DATE_ID"/>
    </input>
    <input node="DATE">
      <mapping xsi:type="Calculation:AttributeMapping" target="CALENDAR_DATE" source="CALENDAR_DATE"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$DATE_ID$DATE_ID" source="DATE_ID"/>
    </input>
    <joinAttribute name="JOIN$DATE_ID$DATE_ID"/>
  </calculationView>
  <calculationView xsi:type="Calculation:ProjectionView" id="FILTER" filterExpressionLanguage="SQL">
    <viewAttributes>
      <viewAttribute id="AMOUNT"/>
      <viewAttribute id="CALENDAR_DATE"/>
      <viewAttribute id="CATEGORY"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="Join_FACT_DIM_2"/>
    <filter>&quot;CALENDAR_DATE&quot; &gt;= '$$IP_DATE_FROM$$'
AND &quot;CALENDAR_DATE&quot; &lt;= '$$IP_DATE_TO$$'
AND &quot;AMOUNT&quot; &gt;= $$IP_MIN_AMOUNT$$
AND &quot;CATEGORY&quot; in ($$IP_CATEGORIES$$)</filter>
  </calculationView>
</calculationViews>
