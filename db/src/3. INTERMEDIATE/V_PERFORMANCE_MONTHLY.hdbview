-- Business context: Aggregates monthly sales performance by product category
-- Performance Indicator - using CASE statement and choosen treshholds

VIEW "V_PERFORMANCE_MONTHLY" AS
    SELECT
        d.YEAR AS ORDER_YEAR,
        d.MONTH AS ORDER_MONTH,
        p.CATEGORY AS PRODUCT_CATEGORY,
        SUM(o.AMOUNT) AS TOTAL_SALES_AMOUNT,

-- Business performance indicator driven by revenue treshold rules
        CASE
            WHEN SUM(o.AMOUNT) >= 10000 THEN 'Green'
            WHEN SUM(o.AMOUNT) >= 5000 THEN 'Yellow'
        ELSE 'Red'
        END AS PERFORMANCE_STATUS

FROM "FACT_ORDERS" o

-- Joining DIM_DATE table for high-performance temporal analysis and DIM_PRODUCT table for product master data
JOIN "DIM_DATE" d
    ON o.DATE_ID = d.DATE_ID
JOIN "DIM_PRODUCT" p
    ON o.PRODUCT_ID = p.PRODUCT_ID

-- Aggregating data across calculated year and month and product categories
GROUP BY
d.YEAR,
d.MONTH,
p.CATEGORY;