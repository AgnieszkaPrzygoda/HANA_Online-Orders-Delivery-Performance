VIEW "V_I_ORDER_ENRICHED" AS
SELECT
    O.ORDER_ID,
    O.CUSTOMER_ID,
    O.CARRIER_ID,
    O.DATE_ID,
    D.CALENDAR_DATE AS ORDER_DATE,
    O.EXPECTED_DELIVERY_DATE,
    O.DELIVERY_DATE,
    O.DELIVERY_STATUS,
    O.CUSTOMER_RATING,
    O.CURRENCY,
    O.AMOUNT AS ORDER_VALUE,

    CASE
        WHEN O.DELIVERY_STATUS = 'Delivered'
             AND O.DELIVERY_DATE IS NOT NULL
        THEN DAYS_BETWEEN(D.CALENDAR_DATE, O.DELIVERY_DATE)
        ELSE NULL
    END AS DELIVERY_DAYS,

    CASE
    WHEN O.DELIVERY_STATUS = 'Delivered'
         AND O.DELIVERY_DATE IS NOT NULL
         AND O.EXPECTED_DELIVERY_DATE IS NOT NULL
    THEN
        CASE
            WHEN O.DELIVERY_DATE > O.EXPECTED_DELIVERY_DATE
            THEN DAYS_BETWEEN(O.EXPECTED_DELIVERY_DATE, O.DELIVERY_DATE)
            ELSE 0
        END
    ELSE NULL
END AS DELAY_DAYS,

    CASE
        WHEN O.DELIVERY_STATUS <> 'Delivered'
             OR O.DELIVERY_DATE IS NULL
        THEN 'Not Delivered'
        WHEN O.DELIVERY_DATE <= O.EXPECTED_DELIVERY_DATE
        THEN 'On Time'
        ELSE 'Late'
    END AS SLA_STATUS

FROM "CAC_I_ORDERS_ORDER_LEVEL" O
LEFT JOIN "CAD_B_DATE" D
    ON O.DATE_ID = D.DATE_ID;