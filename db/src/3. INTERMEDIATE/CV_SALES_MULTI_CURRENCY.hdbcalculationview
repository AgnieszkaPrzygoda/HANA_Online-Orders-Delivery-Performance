    <input node="CAD_B_DATE"/>
  </calculationView>
  <calculationView xsi:type="Calculation:ProjectionView" id="EXCHANGE_RATES" filterExpressionLanguage="SQL">
    <viewAttributes>
      <viewAttribute id="SOURCE_CURRENCY"/>
      <viewAttribute id="TARGET_CURRENCY"/>
      <viewAttribute id="VALID_FROM"/>
      <viewAttribute id="RATE"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="CAD_B_EXCHANGE_RATES"/>
    <filter>&quot;TARGET_CURRENCY&quot; = '$$IP_TARGET_CURRENCY$$'</filter>
  </calculationView>
  <calculationView xsi:type="Calculation:JoinView" id="Join_ORDERS_DATE" cardinality="CN_1" joinType="leftOuter">
    <descriptions>
      <comment text="Connects each order with its order date."/>
    </descriptions>
    <viewAttributes>
      <viewAttribute id="DATE_ID" aggregationType="sum"/>
      <viewAttribute id="AMOUNT" aggregationType="sum"/>
      <viewAttribute id="ORDER_ID" aggregationType="sum"/>
      <viewAttribute id="CALENDAR_DATE"/>
      <viewAttribute id="LINE_ITEM_ID" aggregationType="sum"/>
      <viewAttribute id="CURRENCY"/>
      <viewAttribute hidden="true" id="JOIN$DATE_ID$DATE_ID"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="ORDERS">
      <mapping xsi:type="Calculation:AttributeMapping" target="DATE_ID" source="DATE_ID"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="AMOUNT" source="AMOUNT"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="ORDER_ID" source="ORDER_ID"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="LINE_ITEM_ID" source="LINE_ITEM_ID"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="CURRENCY" source="CURRENCY"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$DATE_ID$DATE_ID" source="DATE_ID"/>
    </input>
    <input node="DATE">
      <mapping xsi:type="Calculation:AttributeMapping" target="CALENDAR_DATE" source="CALENDAR_DATE"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="JOIN$DATE_ID$DATE_ID" source="DATE_ID"/>
    </input>
    <joinAttribute name="JOIN$DATE_ID$DATE_ID"/>
  </calculationView>
  <calculationView xsi:type="Calculation:NonEquiJoinView" id="Join_Historical_Rates" cardinality="CN_N" joinType="inner">
    <descriptions>
      <comment text="Matches exchange rates using source currency and order date. It excludes rates for other source currencies and future dates. Multiple historical rates may still match one order."/>
    </descriptions>
    <viewAttributes>
      <viewAttribute id="AMOUNT" aggregationType="sum"/>
      <viewAttribute id="ORDER_ID" aggregationType="sum"/>
      <viewAttribute id="CALENDAR_DATE"/>
      <viewAttribute id="LINE_ITEM_ID" aggregationType="sum"/>
      <viewAttribute id="CURRENCY"/>
      <viewAttribute id="TARGET_CURRENCY"/>
      <viewAttribute id="VALID_FROM"/>
      <viewAttribute id="RATE" aggregationType="sum"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="Join_ORDERS_DATE">
      <mapping xsi:type="Calculation:AttributeMapping" target="AMOUNT" source="AMOUNT"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="ORDER_ID" source="ORDER_ID"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="CALENDAR_DATE" source="CALENDAR_DATE"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="LINE_ITEM_ID" source="LINE_ITEM_ID"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="CURRENCY" source="CURRENCY"/>
    </input>
    <input node="EXCHANGE_RATES">
      <mapping xsi:type="Calculation:AttributeMapping" target="TARGET_CURRENCY" source="TARGET_CURRENCY"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="VALID_FROM" source="VALID_FROM"/>
      <mapping xsi:type="Calculation:AttributeMapping" target="RATE" source="RATE"/>
    </input>
    <joinAttribute leftColumn="CURRENCY" rightColumn="SOURCE_CURRENCY" operator="EQ"/>
    <joinAttribute leftColumn="CALENDAR_DATE" rightColumn="VALID_FROM" operator="GE"/>
  </calculationView>
  <calculationView xsi:type="Calculation:RankView" id="Rank_Latest_Rate">
    <descriptions>
      <comment text="Selects the latest available rate for each order line and target currency."/>
    </descriptions>
    <viewAttributes>
      <viewAttribute id="AMOUNT" aggregationType="sum"/>
      <viewAttribute id="ORDER_ID" aggregationType="sum"/>
      <viewAttribute id="CALENDAR_DATE"/>
      <viewAttribute id="LINE_ITEM_ID" aggregationType="sum"/>
      <viewAttribute id="CURRENCY"/>
      <viewAttribute id="TARGET_CURRENCY"/>
      <viewAttribute id="VALID_FROM"/>
      <viewAttribute id="RATE" aggregationType="sum"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="Join_Historical_Rates"/>
    <rankingFilter type="RANK" offsetReference="FRONT" dynamicPartitionAttributes="false">
      <partitionViewAttributeName id="ORDER_ID"/>
      <partitionViewAttributeName id="LINE_ITEM_ID"/>
      <partitionViewAttributeName id="TARGET_CURRENCY"/>
      <order byViewAttributeName="VALID_FROM" direction="DESC"/>
      <rankThreshold>
        <value>1</value>
      </rankThreshold>
    </rankingFilter>
  </calculationView>
  <calculationView xsi:type="Calculation:ProjectionView" id="Projection_Currency_Conversion">
    <viewAttributes>
      <viewAttribute id="AMOUNT"/>
      <viewAttribute id="ORDER_ID"/>
      <viewAttribute id="CALENDAR_DATE"/>
      <viewAttribute id="LINE_ITEM_ID"/>
      <viewAttribute id="CURRENCY"/>
      <viewAttribute id="TARGET_CURRENCY"/>
      <viewAttribute id="VALID_FROM"/>
      <viewAttribute id="RATE"/>
    </viewAttributes>
    <calculatedViewAttributes>
      <calculatedViewAttribute id="CONVERTED_AMOUNT" datatype="DECIMAL" length="15" scale="2" expressionLanguage="SQL">
        <descriptions>
          <comment text="Converted amount"/>
        </descriptions>
        <formula>ROUND(&quot;AMOUNT&quot; * &quot;RATE&quot;, 2)</formula>
      </calculatedViewAttribute>
    </calculatedViewAttributes>
    <input node="Rank_Latest_Rate"/>
  </calculationView>
</calculationViews>
