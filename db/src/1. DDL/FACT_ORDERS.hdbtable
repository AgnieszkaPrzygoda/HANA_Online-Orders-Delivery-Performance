COLUMN TABLE FACT_ORDERS (
    ORDER_ID INTEGER NOT NULL,
    LINE_ITEM_ID INTEGER NOT NULL,
    DATE_ID INTEGER,
    CUSTOMER_ID INTEGER,
    PRODUCT_ID INTEGER,
    CARRIER_ID INTEGER,
    DELIVERY_DATE DATE,
    DELIVERY_STATUS NVARCHAR(50),
    QUANTITY INTEGER,
    AMOUNT DECIMAL(10,2),
    PRIMARY KEY (ORDER_ID, LINE_ITEM_ID)
);