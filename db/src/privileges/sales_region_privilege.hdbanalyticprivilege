<?xml version="1.0" encoding="UTF-8"?>
<Privilege:analyticPrivilege xmlns:Privilege="http://www.sap.com/ndb/BiModelPrivilege.ecore" 
id="sales_region_privilege" privilegeType="SQL_ANALYTIC_PRIVILEGE" schemaVersion="1.1">
    <descriptions defaultDescription="Filter data by sales region"/>

    <!-- Define the Calculation View protected by this privilege -->
    <securedModels>
        <modelUri>CV_SALES_WITH_CALCULATIONS</modelUri>
    </securedModels>

    <!-- Allow access only to data from the West region (WE) -->
    <whereSql>&quot;REGION_CODE&quot; = 'WE'</whereSql>
</Privilege:analyticPrivilege>

